# ============================================================
# Railway 生产环境变量模板
# 用法：在 Railway 项目 -> Variables 中逐项添加；
#      或直接复制本文件内容到 Railway 的 "Raw Editor"。
# 注意：Railway 的 MySQL 插件会自动注入 MYSQL_* 变量，
#      因此下面的 DB_* 留空即可（后端配置已自动回退到 MYSQL_*）。
# ============================================================

# ---- 服务 ----
NODE_ENV=production
# Railway 会自动注入 PORT，无需手动设置；本地可用 3001
PORT=3001
# 同源部署，前端走 /api，CORS 用 * 即可
CORS_ORIGIN=*

# ---- 数据库 ----
# 留空：使用 Railway MySQL 插件注入的 MYSQL_HOST/PORT/USER/PASSWORD/DATABASE
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=show_ticket

# ---- 鉴权 ----
# 请改成一段随机长字符串（可用：openssl rand -base64 32）
JWT_SECRET=replace_with_a_random_long_string
JWT_EXPIRES_IN=7d

# ---- 演出资讯同步 ----
# 演示已有 12 场内置数据，可保持关闭；需要真实演出可改 true 或手动执行同步
SYNC_ON_START=false
SYNC_CRON=0 23 * * *
SYNC_CITIES=
SYNC_PAGE_SIZE=20
SYNC_PAGES=1
SYNC_WITH_DETAIL=true
SYNC_DOWNLOAD_IMAGES=false

# ---- 支付（演示用模拟支付，无需任何密钥）----
PAYMENT_MODE=test
# 部署后改成你的 Railway 公网域名，例如 https://xxx.up.railway.app
PAY_BASE_URL=https://your-railway-domain

# ---- 真实支付（PAYMENT_MODE=real 且填齐后才生效，演示可留空）----
WX_APPID=
WX_MCHID=
WX_APIV3_KEY=
WX_SERIAL_NO=
WX_PRIVATE_KEY=
WX_PLATFORM_CERT=
WX_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
