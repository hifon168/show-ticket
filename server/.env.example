# ---------------- 服务配置 ----------------
PORT=3001
NODE_ENV=development
# 前端域名（CORS 白名单，多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------------- 数据库配置 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=show_ticket

# ---------------- 鉴权配置 ----------------
JWT_SECRET=please_change_this_secret_key
JWT_EXPIRES_IN=7d

# ---------------- 演出资讯同步（每日定时任务，公网真实数据源）----------------
# 默认数据源：猫眼演出 / 大众点评 myshow 公开接口，无需鉴权即可同步真实演出与真实海报
# 同步城市：留空则同步 cities 表里的全部城市；也可指定，例：SYNC_CITIES=北京,上海,广州
SYNC_CITIES=
# 每页抓取条数 / 每个分类最多翻几页（>1 时按接口 hasMore 自动翻页）
SYNC_PAGE_SIZE=20
SYNC_PAGES=1
# 是否逐条拉取详情页补全演出介绍（真实演出文案）
SYNC_WITH_DETAIL=true
# 是否把公网海报下载到本地 public/posters（false = 直连源站图片，源站换图本站自动同步）
SYNC_DOWNLOAD_IMAGES=false
# 本地下载模式下的缓存有效期（天）
SYNC_IMAGE_TTL_DAYS=7

# 可选：额外的自定义数据源（返回约定结构的 JSON 数组），留空则只同步上述公网数据源
SYNC_API_URL=
SYNC_API_TOKEN=
# 每日自动同步时间（cron 表达式，Asia/Shanghai，默认每天晚上 23:00）
SYNC_CRON=0 23 * * *
# 启动时是否立即执行一次同步
SYNC_ON_START=false

# ---------------- 支付配置 ----------------
# 支付模式：test（默认，无需任何密钥，模拟完整支付流程）| real（接真实微信/支付宝）
PAYMENT_MODE=test
# 本站对外基础地址（用于拼接支付回调/模拟确认链接，部署时改成公网域名）
PAY_BASE_URL=http://localhost:3001

# ===== 微信支付 V3（PAYMENT_MODE=real 且下列齐全时可用）=====
# 申请入口：微信支付商户平台 https://pay.weixin.qq.com （需企业/个体户资质）
WX_APPID=
WX_MCHID=
WX_APIV3_KEY=
WX_SERIAL_NO=
# 商户 API 私钥（apiclient_key.pem 内容，或该文件路径）
WX_PRIVATE_KEY=
# 微信平台证书公钥（apiclient_cert.pem 内容，或路径）；用于回调验签，缺失时仅解密不验签
WX_PLATFORM_CERT=
# 微信支付异步通知地址（部署后改成公网可访问地址）
WX_NOTIFY_URL=http://localhost:3001/api/pay/notify/wechat

# ===== 支付宝（PAYMENT_MODE=real 且下列齐全时可用）=====
# 申请入口：支付宝开放平台 https://open.alipay.com （"网页&移动应用"创建应用并签约手机网站支付）
ALIPAY_APP_ID=
# 应用私钥（PKCS#8，开发者自行生成）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（开放平台「应用信息-开发设置」中「支付宝公钥」）
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:3001/api/pay/notify/alipay
ALIPAY_RETURN_URL=http://localhost:3001/api/pay/return/alipay

