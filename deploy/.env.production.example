# ============================================================
# 生产环境变量样例
# 用法：复制本文件为 server/.env，并填入真实值后部署
# 应用启动时会通过 dotenv 自动加载 server/.env
# ============================================================

# 服务端口（Nginx 反向代理会转发到这个端口）
PORT=3001
NODE_ENV=production

# ---------- MySQL ----------
# 服务器自建 MySQL 或云 RDS 均可，填对应连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=show_ticket
DB_PASSWORD=请改成强密码
DB_NAME=show_ticket

# ---------- JWT ----------
# 务必改成至少 32 位的随机字符串，不要用默认值
JWT_SECRET=请改成随机长字符串例如$(openssl rand -hex 32)

# ---------- CORS ----------
# 填你的域名（备案通过后）；多个用逗号分隔。备案期间可临时填 *
CORS_ORIGIN=https://你的域名.com,https://www.你的域名.com

# ---------- 每日同步（公网真实数据源，北京时间 23:00）----------
SYNC_CRON=0 23 * * *
SYNC_ON_START=false
# 留空 = 同步 cities 表全部城市；也可指定如 北京,上海,广州
SYNC_CITIES=
SYNC_PAGE_SIZE=20
SYNC_PAGES=1
# 直连源站图片（换图自动同步），演示建议保持 false
SYNC_DOWNLOAD_IMAGES=false

# ---------- 支付（演示/不收款，保持默认即可，无需真实密钥）----------
# 当前为演示模式，alipay/wechatpay 依赖已安装但未启用真实收款
